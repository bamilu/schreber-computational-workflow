@article{girard2022b,
  title = {Computational Analysis of Spoken Language in Acute Psychosis and Mania},
  author = {Girard, J. M. and Vail, A. K. and Liebenthal, E. and Brown, K. and Kilciksiz, C. M. and Pennant, L. and Liebson, E. and {\"O}ng{\"u}r, D. and Morency, L. P. and Baker, J. T.},
  year = 2022,
  month = jul,
  journal = {Schizophr Res},
  edition = {20210826},
  volume = {245},
  pages = {97--115},
  issn = {0920-9964 (Print) 0920-9964},
  doi = {10.1016/j.schres.2021.06.040},
  abstract = {Bom ``modelo'' de desenho emp\'irico e pipeline computacional aplicado \`a fala em psicose; mesmo que n\~ao seja paranoia pura, \'e metodologicamente transfer\'ivel. \_\_\_\_\_\_\_\_\_\_\_\_\_\_\_\_ OBJECTIVES: This study aimed to (1) determine the feasibility of collecting behavioral data from participants hospitalized with acute psychosis and (2) begin to evaluate the clinical information that can be computationally derived from such data. METHODS: Behavioral data was collected across 99 sessions from 38 participants recruited from an inpatient psychiatric unit. Each session started with a semi-structured interview modeled on a typical "clinical rounds" encounter and included administration of the Positive and Negative Syndrome Scale (PANSS). ANALYSIS: We quantified aspects of participants' verbal behavior during the interview using lexical, coherence, and disfluency features. We then used two complementary approaches to explore our second objective. The first approach used predictive models to estimate participants' PANSS scores from their language features. Our second approach used inferential models to quantify the relationships between individual language features and symptom measures. RESULTS: Our predictive models showed promise but lacked sufficient data to achieve clinically useful accuracy. Our inferential models identified statistically significant relationships between numerous language features and symptom domains. CONCLUSION: Our interview recording procedures were well-tolerated and produced adequate data for transcription and analysis. The results of our inferential modeling suggest that automatic measurements of expressive language contain signals highly relevant to the assessment of psychosis. These findings establish the potential of measuring language during a clinical interview in a naturalistic setting and generate specific hypotheses that can be tested in future studies. This, in turn, will lead to more accurate modeling and better understanding of the relationships between expressive language and psychosis.},
  langid = {english},
  keywords = {*Mania,*Psychotic Disorders/psychology,analise linguistica computacional esquizofrenia psicose aguda mania linguagem falada esquizofrenia sintomas negativos sintomas positivos doenca mental psiquiatria psicologia,Bipolar disorder,Humans,Language,Negative symptoms,Positive symptoms,Schizophrenia}
}

@article{he2026b,
  title = {Reduced Linguistic Coherence in Psychosis Defies Semantic Similarity Accounts and Relates to Altered Large-Scale Cortical Hierarchy},
  author = {He, R. and Grodzki, R. and Altay, N. and Aston, B. and {Alonso-S{\'a}nchez}, M. F. and Homan, P. and Sommer, I. and Palaniyappan, L. and Hinzen, W.},
  year = 2026,
  month = feb,
  journal = {Sci Rep},
  edition = {20260208},
  issn = {2045-2322},
  doi = {10.1038/s41598-026-39025-1},
  abstract = {Muito atual e valioso para uma cautela metodol\'ogica: certas m\'etricas autom\'aticas de coer\^encia (incluindo semelhan\c ca sem\^antica com LLMs) podem n\~ao correlacionar com avalia\c c\~oes humanas, o que impacta diretamente qualquer operacionaliza\c c\~ao de ``sistematiza\c c\~ao discursiva''. \_\_\_\_\_\_\_\_\_\_\_\_\_\_\_\_\_\_\_\_ Se reduzirmos o artigo \`aquilo que verdadeiramente est\'a em jogo, ele gira em torno de um problema cl\'assico da psicologia da linguagem e da psicopatologia: como medir objetivamente a coer\^encia do discurso humano, sobretudo quando essa coer\^encia se altera em perturba\c c\~oes psic\'oticas. Durante mais de um s\'eculo, desde Bleuler, a esquizofrenia foi descrita como um fen\'omeno de loosening of associations, isto \'e, uma esp\'ecie de afrouxamento das liga\c c\~oes entre ideias. Clinicamente, isso manifesta-se como discurso aparentemente desconexo, saltos tem\'aticos, ou encadeamentos dif\'iceis de seguir. O problema sempre foi metodol\'ogico: os cl\'inicos reconhecem esse fen\'omeno quando o ouvem, mas como traduzi-lo numa m\'etrica objetiva? Nas \'ultimas duas d\'ecadas, com o avan\c co da lingu\'istica computacional e da intelig\^encia artificial, consolidou-se uma hip\'otese aparentemente elegante: a incoer\^encia poderia ser medida atrav\'es da semelhan\c ca sem\^antica entre palavras ou frases consecutivas. A ideia era simples. Se o discurso for coerente, os conceitos sucessivos estar\~ao relativamente pr\'oximos no espa\c co sem\^antico; se for incoerente, o discurso ``saltar\'a'' entre conceitos distantes. Muitos estudos passaram ent\~ao a utilizar modelos de linguagem, como LSA, BERT ou outros embeddings sem\^anticos, para calcular a proximidade sem\^antica entre segmentos do discurso. O artigo de He e colaboradores questiona diretamente essa premissa. O primeiro passo do estudo consiste em testar empiricamente algo que, surpreendentemente, quase nunca tinha sido testado de forma rigorosa: a semelhan\c ca sem\^antica calculada por modelos de linguagem corresponde realmente \`aquilo que os humanos percebem como coer\^encia? Para isso, os autores analisaram v\'arios grandes conjuntos de dados de fala espont\^anea em diferentes l\'inguas e compararam duas coisas: as avalia\c c\~oes humanas de coer\^encia; os valores produzidos por m\'etricas autom\'aticas baseadas em semelhan\c ca sem\^antica. O resultado \'e desconcertante para a abordagem dominante. A correla\c c\~ao praticamente n\~ao existe. Ou seja, as m\'etricas baseadas em semelhan\c ca sem\^antica n\~ao captam aquilo que os humanos reconhecem como coer\^encia discursiva. Os autores ilustram esse problema com um exemplo simples mas revelador. A frase ``A fox jumped over the tree'' \'e claramente mais coerente do que a sequ\^encia embaralhada ``fox tree jumped over the a''. No entanto, quando se calcula a semelhan\c ca sem\^antica entre as palavras adjacentes, a frase incoerente pode apresentar valores iguais ou at\'e superiores. Isto acontece porque a coer\^encia n\~ao depende apenas de proximidade sem\^antica entre palavras, mas de estrutura sint\'atica, organiza\c c\~ao discursiva e expectativas probabil\'isticas. Este ponto conduz ao segundo movimento conceptual do artigo. Em vez de medir a coer\^encia atrav\'es da proximidade sem\^antica, os autores exploram outras m\'etricas lingu\'isticas, sobretudo m\'etricas probabil\'isticas, como a perplexity. A perplexity mede, de forma simplificada, o grau de previsibilidade de uma sequ\^encia de palavras para um modelo de linguagem. Se uma sequ\^encia for muito improv\'avel segundo as regularidades da l\'ingua, a perplexity aumenta. Os resultados mostram que estas m\'etricas probabil\'isticas correlacionam-se, ainda que modestamente, com as avalia\c c\~oes humanas de coer\^encia. Em termos intuitivos, isto sugere que aquilo que percebemos como discurso coerente pode depender menos da proximidade conceptual entre palavras e mais da previsibilidade das transi\c c\~oes lingu\'isticas dentro da gram\'atica e da estrutura discursiva. O estudo acrescenta ainda um terceiro n\'ivel de an\'alise, que liga lingu\'istica e neuroci\^encia. Num conjunto de participantes que inclu\'ia pessoas com perturba\c c\~oes do espectro da esquizofrenia, os autores analisaram a rela\c c\~ao entre incoer\^encia discursiva e a organiza\c c\~ao funcional do c\'erebro. Utilizando medidas de conectividade funcional em larga escala, encontraram associa\c c\~oes entre a redu\c c\~ao de coer\^encia do discurso e altera\c c\~oes nos chamados gradientes funcionais do c\'erebro, que refletem a organiza\c c\~ao hier\'arquica entre sistemas sensoriais, associativos e de integra\c c\~ao conceptual. Este resultado refor\c ca uma ideia que tem ganho for\c ca na psicologia lingu\'istica contempor\^anea: a linguagem espont\^anea n\~ao \'e apenas um comportamento comunicativo, mas um indicador integrado da organiza\c c\~ao cognitiva do c\'erebro. Quando a arquitetura hier\'arquica de processamento se altera, como pode acontecer na esquizofrenia, o discurso torna-se menos previs\'ivel e menos estruturado. Do ponto de vista te\'orico, o artigo tem duas consequ\^encias importantes para os paradigmas atuais da psicologia da linguagem. A primeira \'e metodol\'ogica. Ele mostra que muitas abordagens computacionais recentes podem estar a medir a coisa errada. A coer\^encia discursiva n\~ao \'e simplesmente uma quest\~ao de proximidade sem\^antica num espa\c co vetorial. Ela envolve m\'ultiplos n\'iveis: sintaxe, pragm\'atica, planeamento discursivo e representa\c c\~ao do interlocutor. Reduzi-la \`a dist\^ancia entre embeddings sem\^anticos pode ser uma simplifica\c c\~ao excessiva. A segunda consequ\^encia \'e conceptual. O estudo aproxima-se de uma vis\~ao da linguagem como um fen\'omeno profundamente hier\'arquico e probabil\'istico. A coer\^encia n\~ao resulta apenas de associa\c c\~oes entre palavras, mas da capacidade do sistema cognitivo de gerar sequ\^encias linguisticamente plaus\'iveis dentro de uma arquitetura neural organizada em m\'ultiplos n\'iveis. Em s\'intese, o que este artigo prop\~oe \'e uma mudan\c ca de foco. Em vez de procurar a incoer\^encia psic\'otica num ``alargamento do espa\c co sem\^antico'', os autores sugerem que ela pode refletir uma perturba\c c\~ao mais profunda da organiza\c c\~ao hier\'arquica do processamento lingu\'istico e cognitivo. O discurso torna-se menos coerente n\~ao porque as palavras estejam semanticamente distantes, mas porque o sistema que organiza e prev\^e a sequ\^encia do discurso perdeu parte da sua estrutura. Essa mudan\c ca de perspetiva \'e particularmente relevante para \'areas como a psiquiatria computacional e a lingu\'istica cl\'inica, onde a fala espont\^anea come\c ca a ser usada como marcador quantitativo de estados mentais. O artigo lembra que, para compreender a psicose atrav\'es da linguagem, n\~ao basta medir semelhan\c cas sem\^anticas. \'E preciso compreender como o c\'erebro organiza probabilisticamente a produ\c c\~ao do discurso ao longo de m\'ultiplos n\'iveis hier\'arquicos.},
  langid = {english},
  keywords = {analise linguistica computacional esquizofrenia psicose aguda mania linguagem falada coerencia discursiva sistematicidade no discurso delirante doenca mental psiquiatria psicologia processamento da linguagem falada LLMs,Coherence,Functional gradient,Language models,Natural language processing,Schizophrenia}
}

@article{hinzen2015b,
  title = {The Linguistics of Schizophrenia: Thought Disturbance as Language Pathology across Positive Symptoms},
  author = {Hinzen, W. and Rossell{\'o}, J.},
  year = 2015,
  journal = {Front Psychol},
  edition = {20150716},
  volume = {6},
  pages = {971},
  issn = {1664-1078 (Print) 1664-1078},
  doi = {10.3389/fpsyg.2015.00971},
  abstract = {Um enquadramento forte para pensar coer\^encia, pragm\'atica e ``context processing'' como fen\'omenos lingu\'isticos, e n\~ao meramente cognitivos; d\'a-te linguagem te\'orica para definires m\'etricas. \_\_\_\_\_\_\_\_\_\_\_\_\_\_\_\_\_ We hypothesize that linguistic (dis-)organization in the schizophrenic brain plays a more central role in the pathogenesis of this disease than commonly supposed. Against the standard view, that schizophrenia is a disturbance of thought or selfhood, we argue that the origins of the relevant forms of thought and selfhood at least partially depend on language. The view that they do not is premised by a theoretical conception of language that we here identify as 'Cartesian' and contrast with a recent 'un-Cartesian' model. This linguistic model empirically argues for both (i) a one-to-one correlation between human-specific thought or meaning and forms of grammatical organization, and (ii) an integrative and co-dependent view of linguistic cognition and its sensory-motor dimensions. Core dimensions of meaning mediated by grammar on this model specifically concern forms of referential and propositional meaning. A breakdown of these is virtually definitional of core symptoms. Within this model the three main positive symptoms of schizophrenia fall into place as failures in language-mediated forms of meaning, manifest either as a disorder of speech perception (Auditory Verbal Hallucinations), abnormal speech production running without feedback control (Formal Thought Disorder), or production of abnormal linguistic content (Delusions). Our hypothesis makes testable predictions for the language profile of schizophrenia across symptoms; it simplifies the cognitive neuropsychology of schizophrenia while not being inconsistent with a pattern of neurocognitive deficits and their correlations with symptoms; and it predicts persistent findings on disturbances of language-related circuitry in the schizophrenic brain.},
  langid = {english},
  keywords = {delusions,discurso esquizofrenico discurso delirante discurso paranoide sistematicidade no discurso delirante patologia da linguagem linguistica da esquizofrenia sisntomas positivos na esquizofrenia psicopatologia psiquiatria,formal thought disorder,hallucinations,language,schizophrenia,self-disturbance,thought}
}

@article{huys2016a,
  title = {Computational Psychiatry as a Bridge from Neuroscience to Clinical Applications},
  author = {Huys, Q. J. M. and Maia, T. V. and Frank, M. J.},
  year = 2016,
  journal = {Nature Neuroscience},
  volume = {19},
  pages = {404--413},
  abstract = {Translating advances in neuroscience into benefits for patients with mental illness presents enormous challenges because it involves both the most complex organ, the brain, and its interaction with a similarly complex environment. Dealing with such complexities demands powerful techniques. Computational psychiatry combines multiple levels and types of computation with multiple types of data in an effort to improve understanding, prediction and treatment of mental illness. Computational psychiatry, broadly defined, encompasses two complementary approaches: data driven and theory driven. Data-driven approaches apply machine-learning methods to high-dimensional data to improve classification of disease, predict treatment outcomes or improve treatment selection. These approaches are generally agnostic as to the underlying mechanisms. Theory-driven approaches, in contrast, use models that instantiate prior knowledge of, or explicit hypotheses about, such mechanisms, possibly at multiple levels of analysis and abstraction. We review recent advances in both approaches, with an emphasis on clinical applications, and highlight the utility of combining them.},
  keywords = {psicologia computacional,psicopatologia computacional,psiquiatria computacional}
}

